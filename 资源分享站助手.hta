<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>资源分享站助手</title>
<hta:application
  id="app"
  applicationname="资源分享站助手"
  border="thin"
  caption="yes"
  maximizebutton="no"
  minimizebutton="yes"
  scroll="auto"
  singleinstance="yes"
  showintaskbar="yes"
  sysmenu="yes"
  windowstate="normal" />
<style>
  * { box-sizing: border-box; }
  html { height: 100%; }
  body {
    margin: 0; width: 720px; min-height: 560px;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px; color: #1b1b1f; background: #f6f8ff;
    -ms-overflow-style: scrollbar;
  }
  /* 顶部：白到淡蓝的渐变，DeepSeek 那种干净的天光感 */
  header {
    position: relative; overflow: hidden;
    padding: 20px 24px; height: 112px;
    background: linear-gradient(120deg, #ffffff 0%, #f3f7ff 52%, #e8f0ff 100%);
    border-bottom: 1px solid #e3ebfb;
  }
  header .glow {
    position: absolute; right: -70px; top: -90px; width: 260px; height: 260px;
    border-radius: 50%; background: radial-gradient(circle, rgba(77,107,254,0.20) 0%, rgba(77,107,254,0) 70%);
  }
  header .topline {
    position: absolute; left: 0; top: 0; height: 3px; width: 100%;
    background: linear-gradient(90deg, #4d6bfe 0%, #7b93ff 45%, #b9c8ff 100%);
  }
  .cast { position: relative; float: left; height: 72px; margin-right: 16px; cursor: pointer; }
  .face-wrap { display: inline-block; margin-right: 8px; animation: floatIn .55s ease-out both; }
  .face {
    display: block; width: 72px; height: 72px; border-radius: 20px;
    border: 2px solid #d8e2ff; background: #fff;
    box-shadow: 0 8px 18px rgba(77,107,254,.20);
    transition: box-shadow .18s, border-color .18s;
  }
  .cast:hover .face { border-color: #4d6bfe; box-shadow: 0 10px 22px rgba(77,107,254,.34); }
  @keyframes floatIn {
    0%   { opacity: 0; -ms-transform: translateY(12px) scale(.88); transform: translateY(12px) scale(.88); }
    100% { opacity: 1; -ms-transform: translateY(0) scale(1); transform: translateY(0) scale(1); }
  }
  header h1 { position: relative; margin: 6px 0 0; font-size: 19px; font-weight: 700; letter-spacing: .01em; color: #14161d; }
  header p { position: relative; margin: 6px 0 0; font-size: 12.5px; color: #7a8296; line-height: 1.5; }
  .grow { clear: both; }
  .status {
    position: absolute; right: 24px; top: 24px;
    display: inline-block; padding: 6px 12px; border-radius: 999px;
    font-size: 12.5px; background: #eef2ff; color: #3b57e0; white-space: nowrap;
    border: 1px solid #dfe6ff;
  }
  .status.off { background: #f2f3f6; color: #6b7280; border-color: #eaebef; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: currentColor; margin-right: 6px; vertical-align: 1px; }

  main { padding: 20px 24px 24px; }
  h2 {
    margin: 0 0 12px; font-size: 12px; font-weight: 700;
    color: #8b93a8; letter-spacing: .12em;
  }
  .grid { margin-bottom: 22px; }
  .grid button { margin: 0 10px 10px 0; }
  button {
    font-family: inherit; font-size: 13.5px; cursor: pointer;
    border: 1px solid #e2e8f5; background: #fff; color: #262933;
    border-radius: 12px; padding: 11px 16px;
    transition: border-color .16s, background .16s, color .16s, box-shadow .16s, transform .08s;
  }
  button:hover { border-color: #4d6bfe; color: #3350e0; box-shadow: 0 4px 12px rgba(77,107,254,.14); }
  button:active { transform: scale(.97); }
  button.primary {
    background: #4d6bfe; border-color: #4d6bfe; color: #fff;
    box-shadow: 0 6px 16px rgba(77,107,254,.28);
  }
  button.primary:hover { background: #3b57e0; border-color: #3b57e0; color: #fff; box-shadow: 0 8px 20px rgba(77,107,254,.36); }
  button.ghost { background: transparent; border-color: transparent; color: #7a8296; }
  button.ghost:hover { background: #fff; color: #3350e0; border-color: #e2e8f5; }
  button.danger { color: #b4342a; border-color: #f2dcda; background: #fff; }
  button.danger:hover { border-color: #d2695e; color: #b4342a; box-shadow: none; }

  .programs { margin-bottom: 22px; }
  .program {
    overflow: hidden;
    background: #fff; border: 1px solid #e8edf8; border-radius: 14px;
    padding: 12px 14px; margin-bottom: 8px;
    transition: border-color .16s, box-shadow .16s;
  }
  .program:hover { border-color: #ccd9ff; box-shadow: 0 6px 16px rgba(77,107,254,.10); }
  .program .info { float: left; }
  .program b { font-weight: 600; color: #1b1b1f; }
  .program .path { color: #8b93a8; font-size: 12px; margin-top: 2px; }
  .program .acts { float: right; }
  .program .acts button { margin-left: 8px; padding: 9px 14px; }
  .empty {
    padding: 16px; border: 1px dashed #dde5f6; border-radius: 14px;
    color: #8b93a8; font-size: 13px; background: #fbfcff;
  }

  footer {
    padding: 14px 24px 18px; border-top: 1px solid #e8edf8; background: #fff;
    overflow: hidden;
  }
  footer .hint { float: left; color: #8b93a8; font-size: 12px; padding-top: 9px; max-width: 420px; line-height: 1.5; }
  footer button { float: right; }
</style>
</head>
<body>
  <header>
    <div class="topline"></div>
    <div class="glow"></div>
    <div class="cast" id="cast" title="点一下换个形象"></div>
    <div>
      <h1>资源分享站助手</h1>
      <p>本地预览、线上站点、还有那些启动脚本，都收在这里。点左边的形象可以换一批。</p>
    </div>
    <span class="status off" id="status"><span class="dot"></span><span id="statusText">检查中…</span></span>
  </header>

  <main>
    <h2>快捷入口</h2>
    <div class="grid">
      <button class="primary" id="btnLocal">打开本地预览</button>
      <button id="btnOnline">打开线上网站</button>
      <button id="btnProject">项目文件夹</button>
      <button id="btnData">数据文件夹</button>
      <button id="btnGithub">上传到 GitHub</button>
      <button id="btnCf">Cloudflare 后台</button>
      <button class="ghost" id="btnRefresh">刷新状态</button>
    </div>

    <h2>启动脚本（自动收录）</h2>
    <div class="programs" id="programs"></div>
  </main>

  <footer>
    <span class="hint" id="hint">新写的 .cmd / .bat 放进项目文件夹，这里会自动出现</span>
    <button class="danger" id="btnReset">清空本地数据</button>
  </footer>

<script>
  var fso = new ActiveXObject('Scripting.FileSystemObject');
  var sh = new ActiveXObject('WScript.Shell');

  /* 自己的位置：助手放在项目根目录，.devdata 和启动脚本都在旁边。 */
  var htaPath = decodeURIComponent(location.pathname || '').replace(/^\//, '').replace(/\//g, '\\');
  var HERE = fso.GetParentFolderName(htaPath);
  var PARENT = fso.GetParentFolderName(HERE);

  /* 自动收录的范围：新脚本放进这两个目录里的任意一个都会被列出来。 */
  var SCAN_DIRS = [HERE, fso.BuildPath(PARENT, '资源分享站')];
  var EXTRA_DIRS = ['', 'tools', 'bin', 'scripts'];

  /* —— 形象 —— 每次打开随机挑 1 到 2 张，点一下换一批。 */
  var FACE_DIR = 'assets/ai-faces/';
  var FACE_COUNT = 18;
  function two(n) { return n < 10 ? '0' + n : '' + n; }
  function pickCast() {
    var want = Math.random() < 0.45 ? 1 : 2;
    var picks = [];
    var guard = 0;
    while (picks.length < want && guard++ < 60) {
      var n = Math.floor(Math.random() * FACE_COUNT);
      var dup = false;
      for (var j = 0; j < picks.length; j++) { if (picks[j] === n) dup = true; }
      if (!dup) picks.push(n);
    }
    var html = '';
    for (var i = 0; i < picks.length; i++) {
      html += '<span class="face-wrap" style="animation-delay:' + (i * 0.12) + 's">'
        + '<img class="face" width="72" height="72" alt="" src="' + FACE_DIR + 'face-' + two(picks[i]) + '.png" />'
        + '</span>';
    }
    document.getElementById('cast').innerHTML = html;
  }

  function runFile(path, visible) {
    try { sh.Run('"' + path + '"', visible === false ? 0 : 1, false); }
    catch (e) { alert('打不开：' + path + '\n' + e.message); }
  }
  function openUrl(url) { runFile(url, true); }
  function openFolder(path) {
    if (!fso.FolderExists(path)) { alert('这个文件夹还没有：' + path); return; }
    sh.Run('explorer.exe "' + path + '"', 1, false);
  }

  /* 扫两个目录（含常见的子目录），把 .cmd / .bat 收进来。 */
  function scanScripts() {
    var found = [], seen = {};
    for (var i = 0; i < SCAN_DIRS.length; i++) {
      for (var j = 0; j < EXTRA_DIRS.length; j++) {
        var dir = EXTRA_DIRS[j] ? fso.BuildPath(SCAN_DIRS[i], EXTRA_DIRS[j]) : SCAN_DIRS[i];
        if (!fso.FolderExists(dir)) continue;
        var e = new Enumerator(fso.GetFolder(dir).Files);
        for (; !e.atEnd(); e.moveNext()) {
          var file = e.item();
          var lower = file.Name.toLowerCase();
          if (lower.slice(-4) !== '.cmd' && lower.slice(-4) !== '.bat') continue;
          if (seen[file.Path.toLowerCase()]) continue;
          seen[file.Path.toLowerCase()] = 1;
          found.push({ name: file.Name, path: file.Path, dir: dir });
        }
      }
    }
    found.sort(function (a, b) { return a.name.localeCompare(b.name, 'zh-CN'); });
    return found;
  }

  function renderScripts() {
    var list = scanScripts();
    var box = document.getElementById('programs');
    if (!list.length) {
      box.innerHTML = '<div class="empty">还没找到启动脚本。把 .cmd 或 .bat 放进项目文件夹，点下面的「刷新状态」就会出现在这里。</div>';
      return;
    }
    var html = '';
    for (var i = 0; i < list.length; i++) {
      var item = list[i];
      var label = item.name.replace(/\.(cmd|bat)$/i, '');
      html += '<div class="program">'
        + '<div class="acts"><button data-run="' + i + '">运行</button>'
        + '<button class="ghost" data-show="' + i + '">定位</button></div>'
        + '<div class="info"><b>' + escapeHtml(label) + '</b>'
        + '<div class="path">' + escapeHtml(shortPath(item.dir)) + '</div></div>'
        + '</div>';
    }
    box.innerHTML = html;
    var buttons = box.getElementsByTagName('button');
    for (var k = 0; k < buttons.length; k++) {
      var b = buttons[k];
      var idx = Number(b.getAttribute('data-run') !== null ? b.getAttribute('data-run') : b.getAttribute('data-show'));
      var isRun = b.getAttribute('data-run') !== null;
      (function (item, isRun) {
        b.onclick = function () {
          if (isRun) runFile(item.path, true);
          else sh.Run('explorer.exe /select,"' + item.path + '"', 1, false);
        };
      })(list[idx], isRun);
    }
  }

  function shortPath(dir) {
    return dir.replace(PARENT + '\\', '');
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  /* 本地服务在不在：打得通就直接开浏览器，打不通就先拉起来。 */
  function checkLocal(callback) {
    var xhr = new XMLHttpRequest();
    var done = false;
    function finish(ok) { if (done) return; done = true; if (callback) callback(ok); }
    try {
      xhr.open('GET', 'http://127.0.0.1:4330/api/usage', true);
      xhr.onreadystatechange = function () { if (xhr.readyState === 4) finish(xhr.status === 200); };
      xhr.send();
      window.setTimeout(function () { finish(false); }, 1500);
    } catch (e) { finish(false); }
  }

  function setStatus(ok) {
    var box = document.getElementById('status');
    box.className = 'status' + (ok ? '' : ' off');
    document.getElementById('statusText').innerHTML = ok ? '本地服务运行中' : '本地服务未启动';
  }

  function refresh() {
    renderScripts();
    setStatus(false);
    checkLocal(function (ok) { setStatus(ok); });
  }

  function openLocal() {
    checkLocal(function (ok) {
      if (ok) { openUrl('http://127.0.0.1:4330/'); return; }
      var list = scanScripts();
      for (var i = 0; i < list.length; i++) {
        if (/本地预览/.test(list[i].name)) { runFile(list[i].path, true); return; }
      }
      var fallback = fso.BuildPath(HERE, '启动本地预览.cmd');
      if (fso.FileExists(fallback)) runFile(fallback, true);
      else alert('没找到启动脚本，也没有本地服务在跑。');
    });
  }

  document.getElementById('cast').onclick = pickCast;
  document.getElementById('btnLocal').onclick = openLocal;
  document.getElementById('btnOnline').onclick = function () { openUrl('https://chchcl.date'); };
  document.getElementById('btnProject').onclick = function () { openFolder(HERE); };
  document.getElementById('btnData').onclick = function () { openFolder(fso.BuildPath(HERE, '.devdata')); };
  document.getElementById('btnGithub').onclick = function () { openUrl('https://github.com/neigecivil/-/upload'); };
  document.getElementById('btnCf').onclick = function () { openUrl('https://dash.cloudflare.com'); };
  document.getElementById('btnRefresh').onclick = refresh;
  document.getElementById('btnReset').onclick = function () {
    var dir = fso.BuildPath(HERE, '.devdata');
    if (!fso.FolderExists(dir)) { alert('本来就没有本地数据文件夹，不用清。'); return; }
    if (!confirm('会把 .devdata 里的账号和文件全删掉（只影响本地预览，线上不受影响）。确定吗？')) return;
    try {
      fso.DeleteFolder(dir, true);
      alert('清好了。下次启动本地预览就是全新的，注册邀请码填 LOCAL-DEV-CODE。');
      refresh();
    } catch (e) { alert('删不掉：' + e.message + '\n可能是本地预览还开着，先去关掉那个黑窗口。'); }
  };

  pickCast();
  refresh();
</script>
</body>
</html>